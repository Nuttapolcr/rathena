      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalOptions>/ignore:4217 %(AdditionalOptions)</AdditionalOptions>
    </Link>
    <PreBuildEvent>
      <Command>if not exist "$(ProjectDir)_deps\lua\src\lua.h" call "$(ProjectDir)fetch_lua.bat"</Command>
      <Message>Fetch Lua 5.4 source if missing</Message>
    </PreBuildEvent>
  </ItemDefinitionGroup>
